# Copy to .env (gitignored). Never commit real values.

# --- Neo4j (AuraDB Free or local) — required by the API and by `npm run load` / `npm run verify`
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Source Postgres (READ-ONLY) — only needed by `npm run probe` / `npm run extract`.
# Teammates do NOT need this: the scrubbed snapshot is committed under data/.
DATABASE_URL=

# --- Scrub salt — HMAC key for deterministic anonymization in `npm run extract`.
# Keep private; re-using the same salt keeps anonymized names stable across re-extracts.
SCRUB_SALT=

# --- Apps
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- LLM providers (OpenAI-compatible). LLM_PROVIDER picks the default; the other is the fallback.
LLM_PROVIDER=openrouter
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-sol
# https://console.crusoecloud.com → Inference → API keys
CRUSOE_API_KEY=
CRUSOE_MODEL=zai-org/GLM-5.3-Flash

# --- Plaud developer platform (console → your Embedded SDK app)
PLAUD_CLIENT_ID=
PLAUD_SECRET_KEY=
# Transcription API key (App Settings → API Keys) — not the same as the secret key
PLAUD_API_KEY=

# --- Walks (chunked recording). The phone reaches /api/walks through a public tunnel, so set a
# long random token here and give the same one to the mobile build. Empty = no check (local only).
WALK_API_TOKEN=
