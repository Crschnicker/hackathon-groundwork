{
  "name": "@groundwork/graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Neo4j access (driver, env, typed queries) + the Postgres → scrubbed CSV → Neo4j ETL scripts.",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./driver": "./src/driver.ts"
  },
  "scripts": {
    "probe": "tsx scripts/probe.ts",
    "extract": "tsx scripts/extract.ts",
    "load": "tsx scripts/load.ts",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.2",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
